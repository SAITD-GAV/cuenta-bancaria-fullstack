# Puerto en el que escucha la API
PORT=5000

# Cadena de conexión a MongoDB local (la base se crea sola al primer uso)
MONGODB_URI=mongodb://127.0.0.1:27017/cuenta_bancaria

# Origen del frontend permitido por CORS (el de Vite por defecto)
CLIENT_URL=http://localhost:5173

# Poner en "true" solo si MongoDB corre como replica set (permite transacciones ACID).
# En un MongoDB local standalone déjalo en "false": la API usa operaciones atómicas
# con compensación automática, que garantiza el mismo resultado.
USE_TRANSACTIONS=false
