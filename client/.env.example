# (Opcional) URL base de la API. Si no se define, el cliente usa "/api" y el proxy de Vite
# reenvía las peticiones a http://localhost:5000 durante el desarrollo.
# VITE_API_URL=http://localhost:5000/api

# (Opcional) Destino del proxy de Vite si la API corre en otro puerto.
# VITE_PROXY_TARGET=http://localhost:5000
